# App
NODE_ENV=development
APP_PORT=3000
APP_CONTAINER_NAME=nest_app
APP_CPU_LIMIT=0.50
APP_MEM_LIMIT=512M

# Database
DB_CONTAINER_NAME=postgres_db
DB_HOST=localhost
DB_PORT=5432
DB_LOCAL=5433
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=application_db
DB_CPU_LIMIT=0.5
DB_MEM_LIMIT=512M

# JWT Authentication
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Swagger
SWAGGER_TITLE=API Documentation
SWAGGER_DESCRIPTION=API documentation for the application
SWAGGER_VERSION=1.0
SWAGGER_PATH=/docs